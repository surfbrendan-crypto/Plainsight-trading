# Postgres connection string (Render Postgres internal or external URL)
DATABASE_URL=postgres://user:password@host:5432/plainsight

# JWT signing secret — generate a long random string
JWT_SECRET=replace-with-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_xxx   # $9/mo price ID from Stripe dashboard
STRIPE_PRICE_PRO=price_xxx     # $19/mo price ID from Stripe dashboard

# Financial Modeling Prep — free tier (250 calls/day, end-of-day data)
FMP_API_KEY=replace-with-your-fmp-key

# Resend (transactional email)
RESEND_API_KEY=re_xxx

# Front-end origin, for CORS
CLIENT_ORIGIN=https://plainsighttrading.com

PORT=4000
